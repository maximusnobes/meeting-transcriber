<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs watch_downloads.sh whenever ~/Downloads changes.
  Replace YOUR_USERNAME, copy to ~/Library/LaunchAgents/, then:
    launchctl load ~/Library/LaunchAgents/com.example.transcribe-watch.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.transcribe-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOUR_USERNAME/Transcription/watch_downloads.sh</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>/Users/YOUR_USERNAME/Downloads</string>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/transcribe-watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/transcribe-watch.log</string>
</dict>
</plist>
